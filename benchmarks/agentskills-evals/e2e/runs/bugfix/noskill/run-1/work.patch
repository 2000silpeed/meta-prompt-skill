-"""금액 계산 유틸리티."""
+"""금액 계산 유틸리티.
+
+정책: docs/PAYMENT_POLICY.md (통화 최소 단위, ROUND_HALF_UP).
+
+내부 계산은 모두 Decimal로 한다. float 인자는 repr 문자열(사람이 입력한 값,
+예: 1.005)로 해석해 Decimal로 바꾼다. float 그대로 Decimal(1.005)를 만들면
+1.00499999...가 되어 HALF_UP 경계에서 한 단위 내려가기 때문이다.
+반환 타입은 기존 호출부 호환을 위해 float을 유지한다.
+"""
+from decimal import ROUND_HALF_UP, Decimal
 
 CURRENCY_DECIMALS = {"KRW": 0, "JPY": 0, "USD": 2, "EUR": 2}
 
 
+def _exponent(currency):
+    try:
+        return CURRENCY_DECIMALS[currency]
+    except KeyError:
+        raise ValueError(f"unsupported currency: {currency!r}") from None
+
+
+def to_decimal(value):
+    """금액·비율을 Decimal로 바꾼다. float은 repr 기준(입력한 10진 값)으로 해석한다."""
+    if isinstance(value, Decimal):
+        return value
+    if isinstance(value, float):
+        return Decimal(repr(value))
+    return Decimal(value)
+
+
+def quantize(value, currency="USD"):
+    """Decimal 값을 통화 최소 단위로 HALF_UP 반올림한 Decimal을 돌려준다."""
+    unit = Decimal(1).scaleb(-_exponent(currency))
+    return to_decimal(value).quantize(unit, rounding=ROUND_HALF_UP)
+
+
+def _out(d):
+    return float(d)
+
+
 def round_amount(value, currency="USD"):
-    """금액을 통화 최소 단위로 반올림한다."""
-    return round(float(value), 2)
+    """금액을 통화 최소 단위로 반올림한다 (ROUND_HALF_UP, 0.5는 0에서 먼 쪽)."""
+    return _out(quantize(value, currency))
+
+
+def multiply_round(amount, factor, currency="USD"):
+    """amount*factor를 Decimal로 정확히 곱한 뒤 한 번만 반올림한다."""
+    return _out(quantize(to_decimal(amount) * to_decimal(factor), currency))
 
 
 def apply_rate(amount, rate, currency="USD"):
     """금액에 비율(세율·할인율 등)을 곱한 값을 반올림해 돌려준다."""
-    return round_amount(amount * rate, currency)
+    return multiply_round(amount, rate, currency)
 
 
 def split_amount(total, parts, currency="USD"):
-    """total을 parts개로 나눈 금액 목록을 돌려준다."""
-    each = round_amount(total / parts, currency)
-    return [each] * parts
+    """total을 parts개로 나눈 금액 목록을 돌려준다.
+
+    합계는 (반올림된) total과 정확히 같고, 나머지 최소 단위는 앞 순번부터 1씩 더한다.
+    음수(환불) total은 절댓값 기준으로 나눈 뒤 부호를 붙인다.
+    """
+    if not isinstance(parts, int) or parts <= 0:
+        raise ValueError(f"parts must be a positive integer: {parts!r}")
+    exp = _exponent(currency)
+    units = int(quantize(total, currency).scaleb(exp))  # 최소 단위 정수
+    sign = -1 if units < 0 else 1
+    base, remainder = divmod(abs(units), parts)
+    shares = [base + 1 if i < remainder else base for i in range(parts)]
+    return [_out(Decimal(sign * s).scaleb(-exp)) for s in shares]
