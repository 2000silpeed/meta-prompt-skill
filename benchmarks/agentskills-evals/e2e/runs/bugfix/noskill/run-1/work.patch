+++ b/tests/test_rounding_policy.py
@@ -0,0 +1,137 @@
+"""docs/PAYMENT_POLICY.md 반올림 정책 회귀 테스트.
+
+PG 연동(payment.gateway)은 실제 결제를 일으키므로 여기서 import하지 않는다.
+"""
+import pytest
+
+from payment.cart import cart_total, line_total, refund_amount
+from payment.money import apply_rate, round_amount, split_amount
+
+
+# --- 1. x.xx5 경계: 이진 부동소수점 표현 때문에 내려가던 값 -------------------
+@pytest.mark.parametrize("value, expected", [
+    (1.005, 1.01),     # 실제 저장값 1.00499999999999989...
+    (2.675, 2.68),     # 실제 저장값 2.67499999999999982...
+    (1.115, 1.12),
+    (10.005, 10.01),   # 우연히 1.0050000000000007...로 저장돼 원래도 맞던 값
+    (0.005, 0.01),
+])
+def test_half_up_binary_float_boundary(value, expected):
+    assert round_amount(value, "USD") == expected
+
+
+# --- 2. 정확히 표현되는 .xx5 에서 은행가 반올림(HALF_EVEN)이 쓰이던 문제 -----
+@pytest.mark.parametrize("value, expected", [
+    (0.125, 0.13),   # round()는 0.12 (짝수 쪽)
+    (0.375, 0.38),
+    (2.5, 2.5),
+])
+def test_half_up_not_bankers(value, expected):
+    assert round_amount(value, "USD") == expected
+
+
+# --- 3. 통화별 자릿수 -----------------------------------------------------
+@pytest.mark.parametrize("value, currency, expected", [
+    (1234.5, "KRW", 1235),
+    (1234.4, "KRW", 1234),
+    (2.5, "JPY", 3),     # round(2.5)==2 이지만 HALF_UP이면 3
+    (99.5, "JPY", 100),
+    (1.005, "EUR", 1.01),
+])
+def test_currency_decimals(value, currency, expected):
+    assert round_amount(value, currency) == expected
+
+
+def test_unknown_currency_rejected():
+    with pytest.raises(ValueError):
+        round_amount(1.0, "BHD")
+
+
+# --- 4. 0, 음수(환불), 큰 금액 ----------------------------------------------
+@pytest.mark.parametrize("value, currency, expected", [
+    (0, "USD", 0),
+    (0.0, "KRW", 0),
+    (0.004, "USD", 0),
+    (-2.675, "USD", -2.68),   # HALF_UP: 0에서 먼 쪽
+    (-0.125, "USD", -0.13),
+    (-1234.5, "KRW", -1235),
+    (123456789012.345, "USD", 123456789012.35),
+    (99999999999999.5, "KRW", 100000000000000),
+])
+def test_zero_negative_large(value, currency, expected):
+    assert round_amount(value, currency) == expected
+
+
+# --- 5. 곱셈 결과가 float에서 경계 아래로 떨어지는 경우 ------------------------
+def test_line_total_product_on_boundary():
+    # 1.855 * 3 == 5.5649999999999995 (float) / 정확히는 5.565 -> 5.57
+    assert line_total(1.855, 3, "USD") == 5.57
+    # 1.335 * 3 == 4.005 이지만 float 곱은 4.004999... -> 4.01
+    assert line_total(1.335, 3, "USD") == 4.01
+
+
+def test_apply_rate_half_up():
+    assert apply_rate(1.25, 0.1, "USD") == 0.13   # 0.125 -> 0.13
+    assert apply_rate(10.05, 0.5, "USD") == 5.03  # 5.025 -> 5.03
+    assert apply_rate(15, 0.1, "KRW") == 2        # 1.5원 -> 2원
+
+
+# --- 6. 장바구니 ------------------------------------------------------------
+def test_cart_tax_rounded_half_up():
+    # 줄 1.25, 세금 0.125 -> 0.13, 합계 1.38
+    assert cart_total([(1.25, 1)], tax_rate=0.1, currency="USD") == 1.38
+
+
+def test_cart_discount_then_tax_per_line():
+    # 줄1: 10.05, 할인 10% = 1.005 -> 1.01, 9.04, 세금 10% = 0.904 -> 0.90, 9.94
+    # 줄2: 3 * 0.1 = 0.30, 할인 0.03, 0.27, 세금 0.027 -> 0.03, 0.30
+    assert cart_total([(10.05, 1), (0.1, 3)], tax_rate=0.1,
+                      discount_rate=0.1, currency="USD") == 10.24
+
+
+def test_cart_krw():
+    # 1,333원 * 3 = 3,999 / 할인 5% = 199.95 -> 200 / 3,799 / 세금 10% = 379.9 -> 380 / 4,179
+    assert cart_total([(1333, 3)], tax_rate=0.1, discount_rate=0.05,
+                      currency="KRW") == 4179
+
+
+def test_cart_many_small_lines_no_float_drift():
+    assert cart_total([(0.1, 1)] * 10, currency="USD") == 1.0
+
+
+# --- 7. 환불 ---------------------------------------------------------------
+def test_refund_half_up():
+    assert refund_amount(10.25, 0.5, "USD") == 5.13   # 5.125 -> 5.13
+    assert refund_amount(1001, 0.5, "KRW") == 501     # 500.5 -> 501
+
+
+# --- 8. 분할 결제: 합계 보존, 나머지는 앞 순번부터 --------------------------
+@pytest.mark.parametrize("total, parts, currency, expected", [
+    (10.0, 3, "USD", [3.34, 3.33, 3.33]),
+    (0.05, 3, "USD", [0.02, 0.02, 0.01]),
+    (10000, 3, "KRW", [3334, 3333, 3333]),
+    (100, 7, "JPY", [15, 15, 14, 14, 14, 14, 14]),
+    (0, 3, "USD", [0, 0, 0]),
+    (0.01, 3, "USD", [0.01, 0, 0]),
+    (9.0, 3, "USD", [3.0, 3.0, 3.0]),
+    (-10.0, 3, "USD", [-3.34, -3.33, -3.33]),
+])
+def test_split_exact(total, parts, currency, expected):
+    result = split_amount(total, parts, currency)
+    assert result == expected
+    assert round_amount(sum(result), currency) == round_amount(total, currency)
+
+
+@pytest.mark.parametrize("cents", range(0, 1001, 7))
+@pytest.mark.parametrize("parts", [2, 3, 6, 7])
+def test_split_sum_property(cents, parts):
+    total = cents / 100
+    result = split_amount(total, parts, "USD")
+    assert len(result) == parts
+    assert round(sum(int(round(x * 100)) for x in result)) == cents
+    assert max(result) - min(result) <= 0.0100001
+
+
+def test_split_invalid_parts():
+    with pytest.raises(ValueError):
+        split_amount(10.0, 0, "USD")
