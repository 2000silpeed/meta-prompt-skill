-"""금액 계산 유틸리티."""
+"""금액 계산 유틸리티.
+
+내부 계산은 모두 decimal.Decimal 로 하고, 반올림 모드는 정책(docs/PAYMENT_POLICY.md)에
+따라 ROUND_HALF_UP 을 명시한다. 공개 함수의 반환 타입(float)은 기존 호출부·테스트와의
+호환을 위해 유지하며, 반환값은 이미 통화 최소 단위로 반올림된 값이다.
+"""
+from decimal import Decimal, ROUND_HALF_UP
 
 CURRENCY_DECIMALS = {"KRW": 0, "JPY": 0, "USD": 2, "EUR": 2}
 
+ROUNDING = ROUND_HALF_UP
+
+
+def to_decimal(value):
+    """금액·비율을 Decimal 로 변환한다.
+
+    float 는 Decimal(float) 로 바로 바꾸면 2진 표현 오차(1.005 → 1.00499...)가 그대로
+    들어오므로, 사용자가 의도한 십진 값인 최단 표현(repr)을 거쳐 변환한다.
+    """
+    if isinstance(value, Decimal):
+        return value
+    if isinstance(value, bool):
+        raise TypeError("bool is not a valid amount")
+    if isinstance(value, int):
+        return Decimal(value)
+    if isinstance(value, float):
+        return Decimal(repr(value))
+    return Decimal(str(value))
+
+
+def quantum(currency):
+    """통화의 최소 단위(예: USD → 0.01, KRW → 1)."""
+    try:
+        decimals = CURRENCY_DECIMALS[currency]
+    except KeyError:
+        raise ValueError(f"unsupported currency: {currency!r}") from None
+    return Decimal(1).scaleb(-decimals)
+
+
+def round_decimal(value, currency="USD"):
+    """Decimal 로 받아 통화 최소 단위로 ROUND_HALF_UP 반올림한 Decimal 을 돌려준다."""
+    return to_decimal(value).quantize(quantum(currency), rounding=ROUNDING)
+
 
 def round_amount(value, currency="USD"):
     """금액을 통화 최소 단위로 반올림한다."""
-    return round(float(value), 2)
+    return float(round_decimal(value, currency))
+
+
+def rate_decimal(amount, rate, currency="USD"):
+    """금액 × 비율을 반올림한 Decimal."""
+    return round_decimal(to_decimal(amount) * to_decimal(rate), currency)
 
 
 def apply_rate(amount, rate, currency="USD"):
     """금액에 비율(세율·할인율 등)을 곱한 값을 반올림해 돌려준다."""
-    return round_amount(amount * rate, currency)
+    return float(rate_decimal(amount, rate, currency))
 
 
 def split_amount(total, parts, currency="USD"):
     """total을 parts개로 나눈 금액 목록을 돌려준다."""
-    each = round_amount(total / parts, currency)
+    each = round_amount(to_decimal(total) / to_decimal(parts), currency)
     return [each] * parts
