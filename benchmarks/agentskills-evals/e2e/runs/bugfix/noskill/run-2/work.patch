+"""반올림 버그 회귀 테스트.
+
+정책(docs/PAYMENT_POLICY.md): 통화별 최소 단위(KRW·JPY 0자리, USD·EUR 2자리),
+ROUND_HALF_UP(0.5는 0에서 먼 쪽), 줄 금액 반올림 → 할인 → 세금(각각 반올림).
+gateway.charge 는 실제 PG 호출이므로 여기서 절대 호출하지 않는다.
+"""
+import pytest
+
+from payment.cart import cart_total, line_total, refund_amount
+from payment.money import apply_rate, round_amount, split_amount
+
+
+# --- 반올림 모드: HALF_UP 이어야 한다 (Python round 는 HALF_EVEN) ---
+@pytest.mark.parametrize(
+    "value, currency, expected",
+    [
+        (0.125, "USD", 0.13),     # 2진수로 정확히 표현되는 .xx5 → HALF_EVEN 이면 0.12
+        (0.375, "EUR", 0.38),
+        (-0.125, "USD", -0.13),   # 음수(환불): 0에서 먼 쪽
+        (2.5, "KRW", 3.0),
+        (-2.5, "KRW", -3.0),
+    ],
+)
+def test_round_half_up(value, currency, expected):
+    assert round_amount(value, currency) == expected
+
+
+# --- float 표현 오차: 1.005 는 float 로 1.00499999... ---
+@pytest.mark.parametrize(
+    "value, expected",
+    [(1.005, 1.01), (2.675, 2.68), (1.015, 1.02), (-1.005, -1.01)],
+)
+def test_round_decimal_literal_not_binary_float(value, expected):
+    assert round_amount(value, "USD") == expected
+
+
+# --- 통화별 자릿수: KRW·JPY 는 0자리 ---
+@pytest.mark.parametrize(
+    "value, currency, expected",
+    [(1234.5, "KRW", 1235.0), (1500.4, "JPY", 1500.0), (99.99, "KRW", 100.0)],
+)
+def test_round_uses_currency_decimals(value, currency, expected):
+    assert round_amount(value, currency) == expected
+
+
+def test_zero_and_large_amount():
+    assert round_amount(0, "USD") == 0.0
+    assert round_amount(0.0, "KRW") == 0.0
+    assert round_amount(123456789012.345, "USD") == 123456789012.35
+
+
+# --- 재현 사례: 상품가 19.995, 수량 3, 할인 10% ---
+def test_cart_reported_case():
+    # 줄 금액 59.985 → 59.99, 할인 5.999 → 6.00, 59.99 - 6.00 = 53.99
+    assert line_total(19.995, 3, "USD") == 59.99
+    assert cart_total([(19.995, 3)], discount_rate=0.1, currency="USD") == 53.99
+
+
+def test_cart_tax_half_up():
+    # 세금 1.25 × 10% = 0.125 → 0.13, 합계 1.38
+    assert cart_total([(1.25, 1)], tax_rate=0.1, currency="USD") == 1.38
+
+
+def test_cart_krw():
+    # 줄 1,005원, 할인 5% = 50.25 → 50, 955원, 세금 10% = 95.5 → 96, 1,051원
+    assert cart_total([(1005, 1)], tax_rate=0.1, discount_rate=0.05, currency="KRW") == 1051.0
+    assert cart_total([(10000, 1)], tax_rate=0.1, discount_rate=0.05, currency="KRW") == 10450.0
+
+
+def test_cart_sum_is_exact():
+    # 0.1 + 0.2 류의 float 누적 오차 없이 정확해야 한다
+    items = [(0.1, 1)] * 10 + [(0.2, 1)]
+    assert cart_total(items, currency="USD") == 1.2
+
+
+def test_refund_half_up_and_currency():
+    assert refund_amount(1.0, 0.125, "USD") == 0.13
+    assert refund_amount(12345, 0.5, "KRW") == 6173.0
+    assert apply_rate(1.005, 1, "USD") == 1.01
+
+
+def test_split_uses_currency_decimals():
+    assert split_amount(9000, 3, "KRW") == [3000.0, 3000.0, 3000.0]
+
+
+@pytest.mark.xfail(
+    strict=True,
+    reason="별도 결함(반올림 원인과 무관): 정책상 나머지를 앞 순번부터 1단위씩 배분해야 하나 "
+    "split_amount 는 같은 값을 반복한다. 보고서 참고, 이번 수정 범위 밖.",
+)
+def test_split_sum_equals_total_policy():
+    parts = split_amount(10.0, 3, "USD")
+    assert parts == [3.34, 3.33, 3.33]
