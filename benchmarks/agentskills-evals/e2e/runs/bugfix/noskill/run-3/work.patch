@@ -0,0 +1,135 @@
+"""반올림 버그 회귀 테스트. 정책: docs/PAYMENT_POLICY.md (ROUND_HALF_UP, 통화별 자릿수)."""
+from decimal import Decimal
+
+import pytest
+
+from payment.cart import cart_total, line_total, refund_amount
+from payment.money import apply_rate, round_amount, split_amount
+
+
+# --- round_amount: 사사오입(HALF_UP) ---------------------------------------
+
+@pytest.mark.parametrize("value, currency, expected", [
+    # 이진 표현이 부정확한 값
+    (2.675, "USD", 2.68),
+    (1.005, "USD", 1.01),
+    (8.345, "EUR", 8.35),
+    # 이진 표현이 정확한 .5 경계 (은행가 반올림이면 짝수 쪽으로 감)
+    (0.125, "USD", 0.13),
+    (0.375, "USD", 0.38),
+    # 음수(환불·취소): 0에서 먼 쪽
+    (-2.675, "USD", -2.68),
+    (-0.125, "USD", -0.13),
+    (-0.5, "KRW", -1),
+    # 0
+    (0, "USD", 0),
+    (0.0, "KRW", 0),
+    (-0.004, "USD", 0),
+    # 소수 0자리 통화
+    (1234.5, "KRW", 1235),
+    (2.5, "KRW", 3),
+    (1234.4, "KRW", 1234),
+    (99.5, "JPY", 100),
+    # 아주 큰 금액
+    (9_999_999_999_999.5, "KRW", 10_000_000_000_000),
+    (12_345_678_901.235, "USD", 12_345_678_901.24),
+])
+def test_round_amount_half_up(value, currency, expected):
+    assert round_amount(value, currency) == expected
+
+
+def test_round_amount_accepts_decimal_and_str():
+    assert round_amount(Decimal("2.675"), "USD") == 2.68
+    assert round_amount("1.005", "USD") == 1.01
+
+
+def test_round_amount_unknown_currency_rejected():
+    with pytest.raises(ValueError):
+        round_amount(1.0, "XYZ")
+
+
+# --- apply_rate: 곱셈 자체가 float이면 x.xx5가 x.xx4999...로 떨어진다 -------
+
+@pytest.mark.parametrize("amount, rate, currency, expected", [
+    (0.35, 0.1, "USD", 0.04),     # float: 0.034999999999999996
+    (1.15, 0.1, "USD", 0.12),     # float: 0.11499999999999999
+    (0.75, 0.3, "USD", 0.23),     # float: 0.22499999999999998
+    (15005, 0.1, "KRW", 1501),    # 1500.5 -> 1501 (기존: 1500.5 그대로)
+    (12345, 0.1, "KRW", 1235),
+])
+def test_apply_rate_half_up(amount, rate, currency, expected):
+    assert apply_rate(amount, rate, currency) == expected
+
+
+def test_line_total_exact():
+    assert line_total(1.005, 1, "USD") == 1.01
+    assert line_total(0.145, 3, "USD") == 0.44   # 0.435 -> 0.44
+    assert line_total(333.5, 1, "KRW") == 334
+
+
+# --- cart_total: 할인 -> 세금, 각각 반올림 ---------------------------------
+
+def test_cart_tax_path():
+    # 세금 0.115 -> 0.12
+    assert cart_total([(1.15, 1)], tax_rate=0.1, currency="USD") == 1.27
+
+
+def test_cart_discount_path():
+    # 할인 0.035 -> 0.04
+    assert cart_total([(0.35, 1)], discount_rate=0.1, currency="USD") == 0.31
+
+
+def test_cart_krw():
+    # 세금 1500.5 -> 1501
+    assert cart_total([(15005, 1)], tax_rate=0.1, currency="KRW") == 16506
+    # 할인 1000 * 0.15 = 150, 세금 850 * 0.1 = 85 -> 935 / 둘째 줄 333*3=999, 할인 149.85->150, 849, 세금 84.9->85, 934
+    assert cart_total([(1000, 1), (333, 3)], tax_rate=0.1, discount_rate=0.15,
+                      currency="KRW") == 935 + 934
+
+
+def test_cart_total_is_sum_of_lines():
+    items = [(0.35, 1), (1.15, 1), (2.675, 1)]
+    each = [cart_total([it], tax_rate=0.1, discount_rate=0.1) for it in items]
+    total = cart_total(items, tax_rate=0.1, discount_rate=0.1)
+    assert Decimal(str(total)) == sum(Decimal(str(x)) for x in each)
+
+
+# --- refund ---------------------------------------------------------------
+
+def test_refund_amount_half_up():
+    assert refund_amount(0.35, 0.1, "USD") == 0.04
+    assert refund_amount(15005, 0.1, "KRW") == 1501
+    assert refund_amount(0, 0.5, "USD") == 0
+
+
+# --- split_amount: 합계 보존, 나머지는 앞 순번부터 1단위 -------------------
+
+@pytest.mark.parametrize("total, parts, currency, expected", [
+    (10.0, 3, "USD", [3.34, 3.33, 3.33]),
+    (0.05, 3, "USD", [0.02, 0.02, 0.01]),
+    (10000, 3, "KRW", [3334, 3333, 3333]),
+    (10001, 3, "KRW", [3334, 3334, 3333]),
+    (100, 7, "JPY", [15, 15, 14, 14, 14, 14, 14]),
+    (-10.0, 3, "USD", [-3.34, -3.33, -3.33]),
+    (0, 3, "USD", [0, 0, 0]),
+    (100_000_000_000_001, 2, "KRW", [50_000_000_000_001, 50_000_000_000_000]),
+])
+def test_split_amount_distributes_remainder(total, parts, currency, expected):
+    assert split_amount(total, parts, currency) == expected
+
+
+@pytest.mark.parametrize("currency", ["USD", "KRW"])
+def test_split_amount_sum_preserved(currency):
+    places = 2 if currency == "USD" else 0
+    for cents in range(0, 2000, 7):
+        total = cents / (10 ** places)
+        for parts in (1, 2, 3, 4, 6, 7):
+            got = split_amount(total, parts, currency)
+            assert len(got) == parts
+            assert sum(Decimal(str(x)) for x in got) == Decimal(str(total)).quantize(
+                Decimal(1).scaleb(-places))
+
+
+def test_split_amount_invalid_parts():
+    with pytest.raises(ValueError):
+        split_amount(10.0, 0, "USD")
