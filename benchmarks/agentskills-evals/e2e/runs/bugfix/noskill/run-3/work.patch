-"""금액 계산 유틸리티."""
+"""금액 계산 유틸리티.
+
+정책(docs/PAYMENT_POLICY.md):
+- 통화별 소수 자릿수: CURRENCY_DECIMALS
+- 반올림: ROUND_HALF_UP(0.5는 0에서 먼 쪽)
+
+모든 계산은 내부적으로 Decimal로 한다. float 입력은 repr(최단 10진 표현)을
+거쳐 Decimal로 바꾸므로 2.675 같은 값이 2.67499...로 해석되지 않는다.
+반환값은 기존 호출부와의 호환을 위해 float로 유지한다.
+"""
+from decimal import ROUND_HALF_UP, Decimal
 
 CURRENCY_DECIMALS = {"KRW": 0, "JPY": 0, "USD": 2, "EUR": 2}
+ROUNDING = ROUND_HALF_UP
+
+
+def to_decimal(value):
+    """int/float/str/Decimal을 정확한 Decimal로 바꾼다. float는 Decimal(float)을 쓰지 않는다."""
+    if isinstance(value, Decimal):
+        return value
+    if isinstance(value, float):
+        return Decimal(repr(value))
+    if isinstance(value, (int, str)):
+        return Decimal(value)
+    raise TypeError(f"unsupported amount type: {type(value).__name__}")
+
+
+def currency_exponent(currency):
+    """통화의 최소 단위(예: USD -> Decimal('0.01'), KRW -> Decimal('1'))."""
+    try:
+        places = CURRENCY_DECIMALS[currency]
+    except KeyError:
+        raise ValueError(f"unknown currency: {currency!r}") from None
+    return Decimal(1).scaleb(-places)
+
+
+def quantize(value, currency):
+    """Decimal 결과를 돌려주는 유일한 반올림 지점."""
+    return to_decimal(value).quantize(currency_exponent(currency), rounding=ROUNDING)
 
 
 def round_amount(value, currency="USD"):
-    """금액을 통화 최소 단위로 반올림한다."""
-    return round(float(value), 2)
+    """금액을 통화 최소 단위로 반올림한다(HALF_UP)."""
+    return float(quantize(value, currency))
 
 
 def apply_rate(amount, rate, currency="USD"):
     """금액에 비율(세율·할인율 등)을 곱한 값을 반올림해 돌려준다."""
-    return round_amount(amount * rate, currency)
+    return float(quantize(to_decimal(amount) * to_decimal(rate), currency))
 
 
 def split_amount(total, parts, currency="USD"):
-    """total을 parts개로 나눈 금액 목록을 돌려준다."""
-    each = round_amount(total / parts, currency)
-    return [each] * parts
+    """total을 parts개로 나눈 금액 목록을 돌려준다.
+
+    합은 (반올림된) total과 정확히 같고, 나머지 최소 단위는 앞 순번부터 1단위씩 더한다.
+    음수(환불)는 절댓값 기준으로 나눈 뒤 부호를 붙인다.
+    """
+    if not isinstance(parts, int) or parts <= 0:
+        raise ValueError(f"parts must be a positive integer: {parts!r}")
+    unit = currency_exponent(currency)
+    minor = int(quantize(total, currency) / unit)  # 최소 단위 정수
+    sign = -1 if minor < 0 else 1
+    base, remainder = divmod(abs(minor), parts)
+    return [
+        float(sign * (base + (1 if i < remainder else 0)) * unit)
+        for i in range(parts)
+    ]
