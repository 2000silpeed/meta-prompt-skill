@@ -0,0 +1,95 @@
+"""반올림 버그 회귀 테스트. 정책: docs/PAYMENT_POLICY.md (ROUND_HALF_UP, 통화별 자릿수)."""
+from decimal import Decimal
+
+import pytest
+
+from payment.money import round_amount, apply_rate, split_amount
+from payment.cart import line_total, cart_total, refund_amount
+
+
+# --- round_amount: x.005 경계, HALF_UP vs HALF_EVEN, 음수, 0 ---
+@pytest.mark.parametrize("value, currency, expected", [
+    (1.005, "USD", 1.01),      # float로는 1.00499999... → 1.0 으로 틀림
+    (2.675, "USD", 2.68),      # float로는 2.67499999... → 2.67
+    (0.125, "USD", 0.13),      # 2진수로 정확한 값. round()는 HALF_EVEN → 0.12
+    (-1.005, "USD", -1.01),    # 환불(음수): 0에서 먼 쪽
+    (-0.125, "EUR", -0.13),
+    (0, "USD", 0.0),
+    (0.0, "KRW", 0.0),
+    (10.123, "USD", 10.12),
+])
+def test_round_half_up_two_decimals(value, currency, expected):
+    assert round_amount(value, currency) == expected
+
+
+@pytest.mark.parametrize("value, currency, expected", [
+    (1234.5, "KRW", 1235),     # 0자리 통화인데 소수 2자리가 남음
+    (2.5, "KRW", 3),           # HALF_EVEN이면 2
+    (1234.4, "JPY", 1234),
+    (-2.5, "JPY", -3),
+    (Decimal("123456789012.5"), "KRW", 123456789013),   # 큰 금액
+    ("19.995", "USD", 20.00),                            # 문자열 입력
+])
+def test_round_by_currency_decimals(value, currency, expected):
+    assert round_amount(value, currency) == expected
+
+
+def test_unknown_currency_is_rejected():
+    with pytest.raises(ValueError):
+        round_amount(1.0, "XYZ")
+
+
+# --- 곱셈 경로: 단가×수량, 비율 적용 ---
+def test_line_total_float_product():
+    # 0.145 * 3 == 0.43499999999999994 (float) → 0.43 으로 틀림. 정답 0.435 → 0.44
+    assert line_total(0.145, 3, "USD") == 0.44
+
+
+def test_apply_rate_half_cent():
+    # 10.05 * 0.5 = 5.025 → 5.03
+    assert apply_rate(10.05, 0.5, "USD") == 5.03
+
+
+def test_refund_half_cent():
+    assert refund_amount(10.05, 0.5, "USD") == 5.03
+
+
+# --- 장바구니: 할인 → 세금, 각각 반올림 ---
+def test_cart_tax_at_half_cent():
+    # 세금 1.15 * 0.1 = 0.115 → 0.12, 합계 1.27
+    assert cart_total([(1.15, 1)], tax_rate=0.1, currency="USD") == 1.27
+
+
+def test_cart_discount_and_tax_krw():
+    # 줄 4500, 할인 675 → 3825, 세금 382.5 → 383, 합계 4208
+    assert cart_total([(1500, 3)], tax_rate=0.1, discount_rate=0.15, currency="KRW") == 4208
+
+
+def test_cart_many_lines_no_float_drift():
+    # 0.1 이 10줄: float 누적이면 0.9999999999999999
+    assert cart_total([(0.1, 1)] * 10, currency="USD") == 1.0
+
+
+# --- 분할: 합 보존, 나머지는 앞 순번부터 1단위 ---
+def test_split_sum_preserved_usd():
+    parts = split_amount(10.0, 3, "USD")
+    assert parts == [3.34, 3.33, 3.33]
+    assert sum(Decimal(str(p)) for p in parts) == Decimal("10.00")
+
+
+def test_split_krw():
+    assert split_amount(100, 3, "KRW") == [34, 33, 33]
+
+
+def test_split_remainder_two_units():
+    assert split_amount(0.05, 3, "USD") == [0.02, 0.02, 0.01]
+
+
+def test_split_negative_refund():
+    parts = split_amount(-10.0, 3, "USD")
+    assert parts == [-3.34, -3.33, -3.33]
+
+
+def test_split_invalid_parts():
+    with pytest.raises(ValueError):
+        split_amount(10.0, 0, "USD")
