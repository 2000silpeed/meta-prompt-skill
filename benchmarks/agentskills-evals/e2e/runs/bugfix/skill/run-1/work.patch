@@ -1,19 +1,66 @@
-"""금액 계산 유틸리티."""
+"""금액 계산 유틸리티.
+
+정책(docs/PAYMENT_POLICY.md): 통화별 최소 단위, ROUND_HALF_UP(0.5는 0에서 먼 쪽).
+내부 계산은 모두 Decimal로 한다. float 입력은 repr 문자열을 거쳐 Decimal로 바꾼다
+(Decimal(1.005)는 1.00499999...가 되므로 쓰지 않는다).
+공개 함수의 반환형은 기존 호출부 호환을 위해 float이며, 반올림이 끝난 값만 float로 바꾼다.
+"""
+from decimal import Decimal, ROUND_HALF_UP
 
 CURRENCY_DECIMALS = {"KRW": 0, "JPY": 0, "USD": 2, "EUR": 2}
 
 
+def to_decimal(value):
+    """금액·비율을 오차 없이 Decimal로 바꾼다."""
+    if isinstance(value, Decimal):
+        return value
+    if isinstance(value, float):
+        return Decimal(repr(value))
+    if isinstance(value, (int, str)):
+        return Decimal(value)
+    raise TypeError(f"unsupported amount type: {type(value).__name__}")
+
+
+def _quantum(currency):
+    try:
+        decimals = CURRENCY_DECIMALS[currency]
+    except KeyError:
+        raise ValueError(f"unsupported currency: {currency!r}") from None
+    return Decimal(1).scaleb(-decimals)
+
+
+def round_decimal(value, currency="USD"):
+    """금액을 통화 최소 단위로 HALF_UP 반올림한 Decimal을 돌려준다."""
+    return to_decimal(value).quantize(_quantum(currency), rounding=ROUND_HALF_UP)
+
+
+def apply_rate_decimal(amount, rate, currency="USD"):
+    return round_decimal(to_decimal(amount) * to_decimal(rate), currency)
+
+
 def round_amount(value, currency="USD"):
     """금액을 통화 최소 단위로 반올림한다."""
-    return round(float(value), 2)
+    return float(round_decimal(value, currency))
 
 
 def apply_rate(amount, rate, currency="USD"):
     """금액에 비율(세율·할인율 등)을 곱한 값을 반올림해 돌려준다."""
-    return round_amount(amount * rate, currency)
+    return float(apply_rate_decimal(amount, rate, currency))
 
 
 def split_amount(total, parts, currency="USD"):
-    """total을 parts개로 나눈 금액 목록을 돌려준다."""
-    each = round_amount(total / parts, currency)
-    return [each] * parts
+    """total을 parts개로 나눈 금액 목록을 돌려준다.
+
+    합은 total(최소 단위로 반올림한 값)과 정확히 같고, 나머지는 앞 순번부터 1단위씩 더한다.
+    """
+    if not isinstance(parts, int) or parts <= 0:
+        raise ValueError(f"parts must be a positive int: {parts!r}")
+    quantum = _quantum(currency)
+    total_d = round_decimal(total, currency)
+    units = int(abs(total_d) / quantum)          # 최소 단위 정수 개수
+    sign = -1 if total_d < 0 else 1
+    base, remainder = divmod(units, parts)
+    return [
+        float(sign * (base + (1 if i < remainder else 0)) * quantum)
+        for i in range(parts)
+    ]
