@@ -0,0 +1,229 @@
+"""반올림 경계값 테스트.
+
+정책 근거: docs/PAYMENT_POLICY.md
+- 사사오입(ROUND_HALF_UP, 0.5는 0에서 먼 쪽), 환불도 같은 규칙
+- 소수 자릿수: KRW·JPY 0, USD·EUR 2
+- 분할: 합이 원금과 정확히 같고, 나머지는 앞 순번부터 1단위씩
+
+PG(payment.gateway)는 호출하지 않는다.
+"""
+from decimal import Decimal
+
+import pytest
+
+from payment.cart import cart_total, line_total, refund_amount
+from payment.money import apply_rate, round_amount, split_amount
+
+
+# --- 반올림 경계: x.xx5 (float로는 x.xx4999... 로 저장되는 값들) ---
+@pytest.mark.parametrize(
+    "value, expected",
+    [
+        (1.005, 1.01),    # float: 1.00499999999999989...
+        (2.675, 2.68),    # float: 2.67499999999999982...
+        (0.125, 0.13),    # float로 정확히 표현됨 → round()의 half-even 때문에 0.12
+        (0.135, 0.14),
+        (0.145, 0.15),
+        (1.015, 1.02),
+        (10.123, 10.12),
+        (10.125, 10.13),
+    ],
+)
+def test_usd_half_up_boundaries(value, expected):
+    assert round_amount(value, "USD") == expected
+
+
+@pytest.mark.parametrize("currency", ["USD", "EUR"])
+def test_two_decimal_currencies(currency):
+    assert round_amount(2.675, currency) == 2.68
+    assert round_amount(0.004, currency) == 0.0
+
+
+@pytest.mark.parametrize(
+    "value, expected",
+    [
+        (100.5, 101),
+        (100.4, 100),
+        (101.5, 102),   # half-even이면 102, 100.5에서 차이가 드러남
+        (0.5, 1),
+        (99.49, 99),
+        (1, 1),
+    ],
+)
+@pytest.mark.parametrize("currency", ["KRW", "JPY"])
+def test_zero_decimal_currencies(value, expected, currency):
+    assert round_amount(value, currency) == expected
+
+
+# --- 음수(환불): 0에서 먼 쪽으로 ---
+@pytest.mark.parametrize(
+    "value, expected, currency",
+    [
+        (-1.005, -1.01, "USD"),
+        (-2.675, -2.68, "USD"),
+        (-0.125, -0.13, "USD"),
+        (-100.5, -101, "KRW"),
+    ],
+)
+def test_negative_half_away_from_zero(value, expected, currency):
+    assert round_amount(value, currency) == expected
+    # 대칭성: round(-x) == -round(x)
+    assert round_amount(-value, currency) == -expected
+
+
+# --- 0과 최소 단위 ---
+def test_zero_and_minimum_units():
+    assert round_amount(0, "USD") == 0
+    assert round_amount(0.0, "KRW") == 0
+    assert round_amount(0.01, "USD") == 0.01
+    assert round_amount(0.005, "USD") == 0.01
+    assert round_amount(0.0049, "USD") == 0.0
+    assert round_amount(1, "KRW") == 1
+
+
+# --- 큰 금액 ---
+@pytest.mark.parametrize(
+    "value, expected, currency",
+    [
+        (99999999.995, 100000000.00, "USD"),
+        (99999999.994, 99999999.99, "USD"),
+        (12345678.905, 12345678.91, "USD"),
+        (-12345678.905, -12345678.91, "USD"),
+        (999999999999.5, 1000000000000, "KRW"),
+    ],
+)
+def test_large_amounts(value, expected, currency):
+    assert round_amount(value, currency) == expected
+
+
+def test_accepts_exact_types():
+    assert round_amount(Decimal("2.675"), "USD") == 2.68
+    assert round_amount("1.005", "USD") == 1.01
+    assert round_amount(3, "USD") == 3
+
+
+def test_unsupported_currency_rejected():
+    with pytest.raises(ValueError):
+        round_amount(1.0, "XXX")
+
+
+# --- 비율 적용 / 줄 금액: 곱셈이 float로 이뤄지면 경계가 깨진다 ---
+def test_apply_rate_boundary():
+    # 0.7 * 1.5 = 1.05 (float 곱은 1.0499999999999998 → 1.04로 틀림)
+    assert apply_rate(0.7, 1.5, "USD") == 1.05
+    assert apply_rate(1005, 0.1, "KRW") == 101  # 100.5 → 101 (float: 100.5, half-even이면 100)
+
+
+def test_line_total_multiplication_boundary():
+    # 1.005 * 3 = 3.015, float 곱은 3.0149999999999997
+    assert line_total(1.005, 3, "USD") == 3.02
+    assert line_total(0.335, 3, "USD") == 1.01  # 1.005
+
+
+def test_refund_amount_boundary():
+    # 2.01 * 0.5 = 1.005 → 1.01 (float 곱의 실제 값은 1.00499999..., round()는 1.0)
+    assert refund_amount(2.01, 0.5, "USD") == 1.01
+    assert refund_amount(201, 0.5, "KRW") == 101
+
+
+# --- 합계 일관성 ---
+def test_cart_lines_sum_equals_total():
+    """정책: 장바구니 합계 = (줄별 반올림 → 할인 반올림 → 세금 반올림) 줄 합계의 합."""
+    items = [(19.99, 3), (0.335, 3), (2.675, 1), (0.1, 7)]
+    discount, tax = 0.15, 0.1
+    expected_lines = []
+    for price, qty in items:
+        line = Decimal(str(price)) * qty
+        line = line.quantize(Decimal("0.01"), "ROUND_HALF_UP")
+        d = (line * Decimal("0.15")).quantize(Decimal("0.01"), "ROUND_HALF_UP")
+        line -= d
+        t = (line * Decimal("0.1")).quantize(Decimal("0.01"), "ROUND_HALF_UP")
+        expected_lines.append(line + t)
+    expected = float(sum(expected_lines))
+    assert cart_total(items, tax_rate=tax, discount_rate=discount, currency="USD") == expected
+
+
+def test_cart_hand_computed():
+    # 줄: 1.005*3=3.015→3.02, 할인 10%: 0.302→0.30 → 2.72, 세금 10%: 0.272→0.27 → 2.99
+    # 줄: 0.1*3=0.3 → 할인 0.03 → 0.27, 세금 0.027→0.03 → 0.30
+    assert cart_total([(1.005, 3), (0.1, 3)], tax_rate=0.1, discount_rate=0.1, currency="USD") == 3.29
+
+
+def test_cart_krw():
