-"""금액 계산 유틸리티."""
+"""금액 계산 유틸리티.
+
+정책: docs/PAYMENT_POLICY.md
+- 반올림은 사사오입(ROUND_HALF_UP, 0.5는 0에서 먼 쪽). 환불(음수)도 동일.
+- 통화별 소수 자릿수는 CURRENCY_DECIMALS를 따른다.
+
+내부 계산은 모두 Decimal로 한다. float 입력은 repr(최단 왕복 표현)을 거쳐
+Decimal로 바꾼다(예: 2.675 → Decimal("2.675")). Decimal(float)을 직접 쓰면
+2.67499999999999982236431605997495353221893310546875 같은 이진 근사값이
+그대로 들어와 사사오입 경계가 깨진다.
+
+공개 함수의 반환형은 기존 호출부·테스트 호환을 위해 float을 유지한다.
+반환되는 float은 반올림된 십진 금액에 가장 가까운 double이며, 다시
+round_amount 등에 넣으면 같은 십진 금액으로 복원된다.
+"""
+from decimal import ROUND_HALF_UP, Decimal
 
 CURRENCY_DECIMALS = {"KRW": 0, "JPY": 0, "USD": 2, "EUR": 2}
 
 
+def to_decimal(value):
+    """금액/비율 값을 정밀도 손실 없이 Decimal로 변환한다."""
+    if isinstance(value, Decimal):
+        return value
+    if isinstance(value, bool):
+        raise TypeError("bool is not a valid amount")
+    if isinstance(value, int):
+        return Decimal(value)
+    if isinstance(value, float):
+        # repr(float)은 같은 double로 되돌아오는 가장 짧은 십진 표현이다.
+        return Decimal(repr(value))
+    if isinstance(value, str):
+        return Decimal(value)
+    raise TypeError(f"unsupported amount type: {type(value).__name__}")
+
+
+def _exponent(currency):
+    try:
+        decimals = CURRENCY_DECIMALS[currency]
+    except KeyError:
+        raise ValueError(f"unsupported currency: {currency!r}") from None
+    return Decimal(1).scaleb(-decimals)  # 0 → 1, 2 → 0.01
+
+
+def quantize(value, currency="USD"):
+    """Decimal 결과로 통화 최소 단위 사사오입(0에서 먼 쪽)."""
+    return to_decimal(value).quantize(_exponent(currency), rounding=ROUND_HALF_UP)
+
+
 def round_amount(value, currency="USD"):
     """금액을 통화 최소 단위로 반올림한다."""
-    return round(float(value), 2)
+    return float(quantize(value, currency))
+
+
+def apply_rate_decimal(amount, rate, currency="USD"):
+    return quantize(to_decimal(amount) * to_decimal(rate), currency)
 
 
 def apply_rate(amount, rate, currency="USD"):
     """금액에 비율(세율·할인율 등)을 곱한 값을 반올림해 돌려준다."""
-    return round_amount(amount * rate, currency)
+    return float(apply_rate_decimal(amount, rate, currency))
 
 
 def split_amount(total, parts, currency="USD"):
-    """total을 parts개로 나눈 금액 목록을 돌려준다."""
-    each = round_amount(total / parts, currency)
-    return [each] * parts
+    """total을 parts개로 나눈 금액 목록을 돌려준다.
+
+    조각의 합은 (최소 단위로 반올림한) total과 정확히 같다. 나머지 최소 단위는
+    앞 순번부터 1단위씩 더한다. 음수 total은 절댓값 기준으로 같은 방식으로
+    나눈 뒤 부호를 붙인다(정책 문서에 음수 분할 방향은 명시되지 않음).
+    """
+    if not isinstance(parts, int) or isinstance(parts, bool) or parts <= 0:
+        raise ValueError("parts must be a positive integer")
+    exp = _exponent(currency)
+    total_dec = quantize(total, currency)
+    units = int(total_dec / exp)  # 최소 단위 정수(정확히 나눠떨어짐)
+    sign = -1 if units < 0 else 1
+    base, remainder = divmod(abs(units), parts)
+    pieces = [base + 1 if i < remainder else base for i in range(parts)]
+    return [float(sign * p * exp) for p in pieces]
