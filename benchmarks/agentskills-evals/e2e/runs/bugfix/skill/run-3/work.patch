+def test_exhaustive_split_sums():
+    for cents in list(range(0, 2001)) + [9999999999]:
+        total = cents / 100
+        for parts in range(1, 13):
+            pieces = split_amount(total, parts, "USD")
+            assert sum(round(p * 100) for p in pieces) == cents, (total, parts)
+            assert max(pieces) - min(pieces) <= 0.0100001
