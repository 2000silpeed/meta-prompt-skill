+# --- 전수 검사: 0.000 ~ 1000.000 의 모든 3자리 십진수 (양수·음수) ---
+def test_exhaustive_three_decimal_values_usd():
+    """float 리터럴로 들어온 모든 x.xxx 값이 십진 사사오입 결과와 일치하는지."""
+    q = Decimal("0.01")
+    mismatches = []
+    for n in range(0, 1_000_001):
+        s = f"{n // 1000}.{n % 1000:03d}"
+        ref = Decimal(s).quantize(q, "ROUND_HALF_UP")
+        f = float(s)
+        if round_amount(f, "USD") != float(ref) or round_amount(-f, "USD") != -float(ref):
+            mismatches.append(s)
+            if len(mismatches) > 5:
+                break
+    assert mismatches == []
+
+
+def test_exhaustive_half_values_krw():
+    for n in range(0, 200_001):
+        s = f"{n // 10}.{n % 10}"
+        ref = Decimal(s).quantize(Decimal("1"), "ROUND_HALF_UP")
+        assert round_amount(float(s), "KRW") == float(ref), s
+        assert round_amount(-float(s), "KRW") == -float(ref), s
