+        (100, 3, [34, 33, 33], "KRW"),
+        (10000, 3, [3334, 3333, 3333], "KRW"),
+        (0.01, 3, [0.01, 0.0, 0.0], "USD"),
+        (9.0, 3, [3.0, 3.0, 3.0], "USD"),
+        (0, 2, [0, 0], "USD"),
+    ],
+)
+def test_split_sum_matches_total(total, parts, expected, currency):
+    result = split_amount(total, parts, currency)
+    assert result == expected
+    assert len(result) == parts
+    exp = 0 if currency in ("KRW", "JPY") else 2
+    scale = 10 ** exp
+    # 최소 단위 정수로 합 비교(float 합산 오차 배제)
+    assert sum(round(x * scale) for x in result) == round(total * scale)
