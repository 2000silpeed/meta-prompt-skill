+     * .ts 파일은 ES 모듈 문법을 쓰므로 이 설정과 무관하게 strict mode로 파싱/출력된다.
+     */
+    "alwaysStrict": false,
+
+    "forceConsistentCasingInFileNames": true,
+    "skipLibCheck": true
+  },
