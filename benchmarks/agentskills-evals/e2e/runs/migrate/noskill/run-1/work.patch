+/** validateItems()를 통과한 주문 품목. */
+export interface LineItem { sku: string; qty: number; price: number }
+
+export interface Quote { subtotal: number; discount: number; shipping: number; total: number }
+
+/** status를 실어 나르는 Error. app.js의 에러 핸들러가 err.status를 응답 코드로 쓴다. */
+export type HttpError = Error & { status?: number };
+
+// NOTE(ts-migration): 일반 객체 리터럴이라 'toString', 'constructor' 같은 Object.prototype 키도
+// 조회된다. 이 경우 rate가 함수가 되어 discount/total이 NaN(JSON에서는 null)이 된다. 원본 동작 그대로 둔다.
+export const COUPONS: Record<string, number | undefined> = { WELCOME10: 0.1, VIP20: 0.2 };
+
+export function subtotal(items: readonly LineItem[]): number {
+  return items.reduce((s, it) => s + it.price * it.qty, 0);
+}
+
+// coupon은 routes/orders.js가 요청 body 값을 검증 없이 넘기므로 unknown으로 받는다.
+export function quote(items: readonly LineItem[], coupon?: unknown): Quote {
+  const sub = subtotal(items);
+  // NOTE(ts-migration): coupon이 문자열이 아니어도 프로퍼티 키로 강제 변환되어 조회된다
+  // (예: ["VIP20"] -> "VIP20"으로 할인 적용, 123 -> "123" -> unknown coupon).
+  const rate = coupon ? COUPONS[coupon as string] : 0;
+  if (coupon && rate === undefined) {
+    const err: HttpError = new Error('unknown coupon');
+    err.status = 400;
+    throw err;
+  }
+  // 위 분기 때문에 여기서 rate는 undefined가 아니지만(coupon이 falsy면 0) TS가 좁히지 못해 단언한다.
+  const discount = Math.round(sub * rate!);
+  const shipping = sub - discount >= 30000 ? 0 : 3000;
+  return { subtotal: sub, discount, shipping, total: sub - discount + shipping };
+}
