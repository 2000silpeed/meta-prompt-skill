+/**
+ * 저장된 주문. 저장소가 보장하는 것은 id와 status뿐이고, 나머지 필드는 create()/update()에
+ * 넘긴 데이터가 그대로 들어간다(현재는 routes/orders.js가 items, coupon, quote 결과를 넣는다).
+ * status는 코드상 'pending' | 'cancelled' | 'shipped'만 쓰지만 저장소가 강제하지 않으므로 string으로 둔다.
+ */
+export interface Order {
+  id: string;
+  status: string;
+  [key: string]: unknown;
+}
+
+const orders = new Map<string, Order>();
+let seq = 1;
+
+// NOTE(ts-migration): create()는 data를 마지막에 펼치므로 data에 id/status가 있으면 그 값이 덮어쓴다.
+// update()도 patch.id를 그대로 반영해 Map 키와 o.id가 어긋날 수 있다. 원본 동작 그대로 둔다.
+export function reset(): void { orders.clear(); seq = 1; }
+export function create(data: Record<string, unknown>): Order { const id = String(seq++); const o: Order = { id, status: 'pending', ...data }; orders.set(id, o); return o; }
+export function get(id: string | number): Order | null { return orders.get(String(id)) || null; }
+export function update(id: string | number, patch: Record<string, unknown>): Order | null { const o = get(id); if (!o) return null; Object.assign(o, patch); return o; }
+export function list(): Order[] { return Array.from(orders.values()); }
