+/** 검증 전 요소를 읽을 때의 모양. 원본은 요소가 객체인지 확인하지 않는다(아래 NOTE). */
+type UncheckedItem = { sku?: unknown; qty?: unknown; price?: unknown };
+
+// items는 요청 body에서 그대로 들어오는 값이므로 unknown으로 받는다.
+export function validateItems(items: unknown): string | null {
+  if (!Array.isArray(items) || items.length === 0) return 'items must be a non-empty array';
+  // NOTE(ts-migration): 요소가 null/undefined이면 `it.sku`에서 TypeError가 나서 500으로 응답된다.
+  // 원본 동작을 보존하기 위해 요소를 검사 없이 UncheckedItem으로 단언한다.
+  for (const it of items as UncheckedItem[]) {
+    if (typeof it.sku !== 'string' || !it.sku) return 'sku is required';
+    // Number.isInteger는 타입을 좁히지 않으므로, 통과한 뒤의 비교를 위해 number로 단언한다.
+    if (!Number.isInteger(it.qty) || (it.qty as number) <= 0) return 'qty must be a positive integer';
+    // NOTE(ts-migration): NaN/Infinity는 typeof가 'number'이고 `< 0`이 false라서 통과한다.
+    if (typeof it.price !== 'number' || it.price < 0) return 'price must be a non-negative number';
+  }
+  return null;
+}
