+"use strict";
+const express = require("express");
+const orders = require("./routes/orders");
+const app = express();
+app.use(express.json());
+app.get('/health', (req, res) => res.json({ ok: true }));
+app.use('/orders', orders);
+// 인자가 4개여야 Express가 에러 핸들러로 인식한다. next를 쓰지 않아도 지우면 안 된다.
+app.use((err, req, res, next) => {
+    // as: 원래 JS는 err의 형태를 검증하지 않고 status/message를 그대로 읽었다.
+    //     next(err)에는 어떤 값이든 올 수 있지만, 동작을 보존하려고 검증을 추가하지 않고 단언만 한다.
+    // TODO(ts-migration): 500 에러(예: 예상하지 못한 TypeError)도 err.message를 그대로 응답해서 내부 정보가 노출된다.
+    //     err.status가 유효한 HTTP 코드인지도 검사하지 않는다.
+    const e = err;
+    res.status(e.status || 500).json({ error: e.message || 'internal error' });
+});
+module.exports = app;
