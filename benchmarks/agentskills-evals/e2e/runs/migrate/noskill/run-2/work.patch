+export type OrderStatus = 'pending' | 'cancelled' | 'shipped';
+
+export interface OrderItem {
+  sku: string;
+  qty: number;
+  price: number;
+}
+
+export interface Quote {
+  subtotal: number;
+  discount: number;
+  shipping: number;
+  total: number;
+}
+
+export interface Order extends Quote {
+  id: string;
+  status: OrderStatus;
+  items: OrderItem[];
+  coupon: string | null;
+}
+
+/** store.create()에 넘기는 값. id와 status는 store가 채운다. */
+export type NewOrder = Omit<Order, 'id' | 'status'>;
