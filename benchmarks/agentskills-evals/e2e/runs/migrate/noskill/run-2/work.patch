+"use strict";
+Object.defineProperty(exports, "__esModule", { value: true });
+exports.COUPONS = void 0;
+exports.quote = quote;
+exports.subtotal = subtotal;
+// TODO(ts-migration): 일반 객체라서 COUPONS["toString"]처럼 프로토타입 체인의 키도 조회된다.
+//     coupon이 "toString" 또는 "constructor"면 rate가 함수가 되어 discount/total이 NaN이 되고
+//     (JSON 응답에서는 null) 201로 주문이 생성된다. 고칠 때는 Object.hasOwn 검사나 Map을 쓰면 된다.
+const COUPONS = { WELCOME10: 0.1, VIP20: 0.2 };
+exports.COUPONS = COUPONS;
+function subtotal(items) {
+    return items.reduce((s, it) => s + it.price * it.qty, 0);
+}
+function quote(items, coupon) {
+    const sub = subtotal(items);
+    // 원래 코드: `const rate = coupon ? COUPONS[coupon] : 0; if (coupon && rate === undefined) throw ...`
+    // TS가 rate를 number로 좁힐 수 있게 같은 분기를 if 블록으로 다시 썼다. 동작은 같다.
+    // String(coupon)은 JS가 속성 키를 변환하는 결과(ToPropertyKey)와 같다(심볼은 JSON 입력에 없다).
+    // TODO(ts-migration): 문자열이 아닌 coupon도 문자열로 바뀌어 조회된다. 예를 들어 ["WELCOME10"]도 할인이 적용된다.
+    let rate = 0;
+    if (coupon) {
+        const found = COUPONS[String(coupon)];
+        if (found === undefined) {
+            const err = new Error('unknown coupon');
+            err.status = 400;
+            throw err;
+        }
+        rate = found;
+    }
+    const discount = Math.round(sub * rate);
+    const shipping = sub - discount >= 30000 ? 0 : 3000;
+    return { subtotal: sub, discount, shipping, total: sub - discount + shipping };
+}
