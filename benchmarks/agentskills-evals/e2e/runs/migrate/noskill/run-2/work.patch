--- /dev/null
+++ b/src/routes/orders.ts
@@ -0,0 +1,58 @@
+import express = require('express');
+import type { NextFunction, Request, Response } from 'express';
+import store = require('../store');
+import { validateItems } from '../validate';
+import { quote } from '../services/pricing';
+import type { OrderItem } from '../types/order';
+
+/** POST /orders 요청 본문. 외부 입력이므로 필드는 모두 unknown이고 아래에서 검증한다. */
+type CreateOrderBody = { items?: unknown; coupon?: unknown };
+
+const router = express.Router();
+
+router.post('/', (req: Request<Record<string, string>, unknown, CreateOrderBody | undefined>, res: Response, next: NextFunction) => {
+  const { items, coupon } = req.body || {};
+  const msg = validateItems(items);
+  if (msg) return res.status(400).json({ error: msg });
+  // as: validateItems가 null을 반환했으면 모든 항목의 sku/qty/price 타입이 검증된 것이다.
+  //     validateItems는 type predicate가 아니라 메시지를 반환하는 함수라서 여기서 단언한다.
+  const validItems = items as OrderItem[];
+  try {
+    const q = quote(validItems, coupon);
+    // as: quote()를 통과한 coupon은 사실상 COUPONS의 키 문자열이지만, 타입으로는 증명할 수 없다.
+    // TODO(ts-migration): 문자열이 아닌 coupon(예: ["WELCOME10"])도 quote를 통과해서 원래 값 그대로
+    //     저장되고 응답된다. 그래서 Order.coupon 타입(string | null)과 실제 값이 다를 수 있다.
+    const order = store.create({ items: validItems, coupon: (coupon || null) as string | null, ...q });
+    res.status(201).json(order);
+  } catch (e) { next(e); }
+});
+
+router.get('/', (req, res) => {
+  // TODO(ts-migration): ?status=a&status=b처럼 배열로 들어오면 어떤 주문과도 일치하지 않아 빈 배열을 반환한다.
+  //     허용하지 않는 status 값도 검증하지 않는다.
+  const { status } = req.query;
+  const all = store.list();
+  res.json(status ? all.filter(o => o.status === status) : all);
+});
+
+router.get('/:id', (req, res) => {
+  const o = store.get(req.params.id);
+  if (!o) return res.status(404).json({ error: 'order not found' });
+  res.json(o);
+});
+
+router.post('/:id/cancel', (req, res) => {
+  const o = store.get(req.params.id);
+  if (!o) return res.status(404).json({ error: 'order not found' });
+  if (o.status === 'shipped') return res.status(409).json({ error: 'shipped order cannot be cancelled' });
+  res.json(store.update(o.id, { status: 'cancelled' }));
+});
+
+router.post('/:id/ship', (req, res) => {
+  const o = store.get(req.params.id);
+  if (!o) return res.status(404).json({ error: 'order not found' });
+  if (o.status !== 'pending') return res.status(409).json({ error: `cannot ship ${o.status} order` });
+  res.json(store.update(o.id, { status: 'shipped' }));
+});
+
+export = router;
