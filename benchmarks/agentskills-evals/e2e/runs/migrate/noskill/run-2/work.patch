@@ -0,0 +1,12 @@
+import type { NewOrder, Order } from './types/order';
+
+const orders = new Map<string, Order>();
+let seq = 1;
+
+function reset(): void { orders.clear(); seq = 1; }
+function create(data: NewOrder): Order { const id = String(seq++); const o: Order = { id, status: 'pending', ...data }; orders.set(id, o); return o; }
+function get(id: string | number): Order | null { return orders.get(String(id)) || null; }
+function update(id: string | number, patch: Partial<Order>): Order | null { const o = get(id); if (!o) return null; Object.assign(o, patch); return o; }
+function list(): Order[] { return Array.from(orders.values()); }
+
+export { reset, create, get, update, list };
