+"use strict";
+Object.defineProperty(exports, "__esModule", { value: true });
+exports.validateItems = validateItems;
+/**
+ * 오류 메시지를 반환하고, 유효하면 null을 반환한다.
+ * null을 반환했다면 items는 OrderItem[] 형태임이 보장된다.
+ */
+function validateItems(items) {
+    if (!Array.isArray(items) || items.length === 0)
+        return 'items must be a non-empty array';
+    // as: 원래 JS는 각 항목이 객체인지 확인하지 않고 바로 속성을 읽는다.
+    //     null/undefined 항목이면 TypeError가 나서 500 응답이 되는데, 이 동작을 보존하려고
+    //     객체 검사를 추가하지 않고 단언만 한다.
+    // TODO(ts-migration): items에 null/undefined가 있으면 TypeError가 나서 400 대신 500으로 응답하고,
+    //     내부 에러 메시지("Cannot read properties of null ...")가 클라이언트에 노출된다.
+    for (const it of items) {
+        if (typeof it.sku !== 'string' || !it.sku)
+            return 'sku is required';
+        // typeof 검사는 동작을 바꾸지 않는다. 숫자가 아니면 Number.isInteger도 false라서 결과가 같다.
+        // TS가 qty를 number로 좁히도록 추가한 것이다.
+        if (typeof it.qty !== 'number' || !Number.isInteger(it.qty) || it.qty <= 0)
+            return 'qty must be a positive integer';
+        if (typeof it.price !== 'number' || it.price < 0)
+            return 'price must be a non-negative number';
+    }
+    return null;
+}
