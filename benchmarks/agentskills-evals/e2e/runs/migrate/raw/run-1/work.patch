@@ -0,0 +1,26 @@
+import type { Order } from './types';
+
+export type NewOrder = Omit<Order, 'id' | 'status'>;
+
+const orders = new Map<string, Order>();
+let seq = 1;
+
+export function reset(): void { orders.clear(); seq = 1; }
+
+export function create(data: NewOrder): Order {
+  const id = String(seq++);
+  const o: Order = { id, status: 'pending', ...data };
+  orders.set(id, o);
+  return o;
+}
+
+export function get(id: string | number): Order | null { return orders.get(String(id)) || null; }
+
+export function update(id: string | number, patch: Partial<Order>): Order | null {
+  const o = get(id);
+  if (!o) return null;
+  Object.assign(o, patch);
+  return o;
+}
+
+export function list(): Order[] { return Array.from(orders.values()); }
