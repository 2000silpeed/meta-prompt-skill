@@ -0,0 +1,26 @@
+export interface OrderItem {
+  sku: string;
+  qty: number;
+  price: number;
+}
+
+export type OrderStatus = 'pending' | 'cancelled' | 'shipped';
+
+export interface Quote {
+  subtotal: number;
+  discount: number;
+  shipping: number;
+  total: number;
+}
+
+export interface Order extends Quote {
+  id: string;
+  status: OrderStatus;
+  items: OrderItem[];
+  coupon: string | null;
+}
+
+/** Error carrying an HTTP status, consumed by the error handler in app.ts. */
+export interface HttpError extends Error {
+  status?: number;
+}
