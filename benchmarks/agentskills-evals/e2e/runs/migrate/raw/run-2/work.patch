+++ b/src/store.ts
@@ -0,0 +1,31 @@
+import type { NewOrder, Order } from './types/order';
+
+const orders = new Map<string, Order>();
+let seq = 1;
+
+export function reset(): void {
+  orders.clear();
+  seq = 1;
+}
+
+export function create(data: NewOrder): Order {
+  const id = String(seq++);
+  const o: Order = { id, status: 'pending', ...data };
+  orders.set(id, o);
+  return o;
+}
+
+export function get(id: string | number): Order | null {
+  return orders.get(String(id)) || null;
+}
+
+export function update(id: string | number, patch: Partial<Omit<Order, 'id'>>): Order | null {
+  const o = get(id);
+  if (!o) return null;
+  Object.assign(o, patch);
+  return o;
+}
+
+export function list(): Order[] {
+  return Array.from(orders.values());
+}
