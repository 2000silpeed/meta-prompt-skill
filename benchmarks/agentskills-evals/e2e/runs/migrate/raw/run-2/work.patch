+++ b/src/services/pricing.ts
@@ -0,0 +1,19 @@
+import { HttpError } from '../errors';
+import type { OrderItem, Quote } from '../types/order';
+
+export const COUPONS: Record<string, number> = { WELCOME10: 0.1, VIP20: 0.2 };
+
+export function subtotal(items: OrderItem[]): number {
+  return items.reduce((s, it) => s + it.price * it.qty, 0);
+}
+
+export function quote(items: OrderItem[], coupon?: string | null): Quote {
+  const sub = subtotal(items);
+  const rate: number | undefined = coupon ? COUPONS[coupon] : 0;
+  if (rate === undefined) {
+    throw new HttpError(400, 'unknown coupon');
+  }
+  const discount = Math.round(sub * rate);
+  const shipping = sub - discount >= 30000 ? 0 : 3000;
+  return { subtotal: sub, discount, shipping, total: sub - discount + shipping };
+}
