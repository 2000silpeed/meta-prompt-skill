@@ -0,0 +1,31 @@
+import type { HttpError, LineItem, Quote } from '../types';
+
+// Mutable on purpose (same as the JS version); typing the lookup result as
+// `number | undefined` reflects that unknown codes miss.
+const COUPONS: Record<string, number | undefined> = { WELCOME10: 0.1, VIP20: 0.2 };
+
+function subtotal(items: readonly LineItem[]): number {
+  return items.reduce((s, it) => s + it.price * it.qty, 0);
+}
+
+/**
+ * @param coupon untrusted value from the request body (any JSON value or undefined).
+ */
+function quote(items: readonly LineItem[], coupon?: unknown): Quote {
+  const sub = subtotal(items);
+  // TODO(ts): `coupon` is not validated as a string. Property-key coercion of arbitrary JSON
+  // values is kept as-is (e.g. ["VIP20"] resolves to "VIP20"), and inherited keys such as
+  // "toString" are NOT undefined -> NaN totals. See migration report (bug candidate).
+  const rate = coupon ? COUPONS[coupon as string] : 0;
+  if (coupon && rate === undefined) {
+    const err: HttpError = new Error('unknown coupon');
+    err.status = 400;
+    throw err;
+  }
+  // Non-null: either coupon is falsy (rate = 0) or the undefined case threw above.
+  const discount = Math.round(sub * rate!);
+  const shipping = sub - discount >= 30000 ? 0 : 3000;
+  return { subtotal: sub, discount, shipping, total: sub - discount + shipping };
+}
+
+export { quote, subtotal, COUPONS };
