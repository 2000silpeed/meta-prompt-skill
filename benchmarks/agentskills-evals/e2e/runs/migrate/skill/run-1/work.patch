@@ -0,0 +1,20 @@
+/**
+ * Validates untrusted `items` from a request body.
+ * Returns an error message, or null when `items` is a valid `LineItem[]`.
+ */
+function validateItems(items: unknown): string | null {
+  if (!Array.isArray(items) || items.length === 0) return 'items must be a non-empty array';
+  for (const raw of items as unknown[]) {
+    // TODO(ts): elements are unvalidated external input. This assertion only names the fields
+    // we inspect; it does NOT check that `raw` is an object. A null/undefined element
+    // (e.g. `items: [null]`) still throws a TypeError here -> 500, exactly as before.
+    // See migration report (bug candidate) before changing.
+    const it = raw as { sku?: unknown; qty?: unknown; price?: unknown };
+    if (typeof it.sku !== 'string' || !it.sku) return 'sku is required';
+    // `typeof` guard is for narrowing only; Number.isInteger() is already false for non-numbers.
+    if (typeof it.qty !== 'number' || !Number.isInteger(it.qty) || it.qty <= 0) return 'qty must be a positive integer';
+    if (typeof it.price !== 'number' || it.price < 0) return 'price must be a non-negative number';
+  }
+  return null;
+}
+export { validateItems };
