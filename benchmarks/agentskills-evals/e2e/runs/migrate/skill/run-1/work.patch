+import express, { type NextFunction, type Request, type Response } from 'express';
+import orders from './routes/orders';
+
+/**
+ * Anything can reach the error middleware (thrown values, body-parser errors, next(x)).
+ * Only `status` and `message` are read, both optional; Express never calls it with null/undefined.
+ */
+interface ErrorLike {
+  status?: number;
+  message?: string;
+}
+
+const app = express();
+app.use(express.json());
+app.get('/health', (req, res) => res.json({ ok: true }));
+app.use('/orders', orders);
+// Must keep all 4 parameters: Express identifies error middleware by arity (fn.length === 4).
+app.use((err: ErrorLike, req: Request, res: Response, next: NextFunction) => {
+  res.status(err.status || 500).json({ error: err.message || 'internal error' });
+});
+
+// `export =` keeps `require('../src/app')` returning the app itself (tests are still JS).
+export = app;
