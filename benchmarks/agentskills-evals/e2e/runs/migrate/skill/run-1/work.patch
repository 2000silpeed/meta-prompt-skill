+// Shared domain types. Type-only module: emits no runtime code of significance.
+
+export type OrderStatus = 'pending' | 'cancelled' | 'shipped';
+
+/** A line item that has passed validateItems(). */
+export interface LineItem {
+  sku: string;
+  qty: number;
+  price: number;
+}
+
+export interface Quote {
+  subtotal: number;
+  discount: number;
+  shipping: number;
+  total: number;
+}
+
+export interface Order extends Quote {
+  id: string;
+  status: OrderStatus;
+  items: LineItem[];
+  // TODO(ts): stored exactly as received from the request body (or null). It is only
+  // checked for truthiness and used as a coupon lookup key, so non-string JSON values
+  // such as ["VIP20"] can end up here. Narrow to `string | null` once input is validated.
+  coupon: unknown;
+}
+
+/** Error carrying an HTTP status, consumed by the error middleware in app. */
+export interface HttpError extends Error {
+  status?: number;
+}
