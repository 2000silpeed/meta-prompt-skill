+// Shared domain types (type-only; import with `import type` so no runtime require is emitted).
+
+export type OrderStatus = 'pending' | 'cancelled' | 'shipped';
+
+export interface OrderItem {
+  sku: string;
+  qty: number;
+  price: number;
+}
+
+export interface Quote {
+  subtotal: number;
+  discount: number;
+  shipping: number;
+  total: number;
+}
+
+export interface Order extends Quote {
+  id: string;
+  status: OrderStatus;
+  items: OrderItem[];
+  coupon: string | null;
+}
+
+/** Error carrying an HTTP status, read by the error handler in app. */
+export interface HttpError extends Error {
+  status?: number;
+}
