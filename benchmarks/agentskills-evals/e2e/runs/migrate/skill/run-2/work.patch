--- /dev/null
+++ b/tsconfig.json
@@ -0,0 +1,29 @@
+{
+  // Base config used by `npm run typecheck` (tsc --noEmit) and ts-jest.
+  // Migration notes (see TS_MIGRATION.md):
+  // - module/moduleResolution: the repo is CommonJS (no "type" in package.json,
+  //   require/module.exports everywhere), so emit CommonJS.
+  // - esModuleInterop stays off: TS files import CJS packages with
+  //   `import x = require('x')`, which emits a plain `require` (no __importDefault
+  //   helpers), so runtime behaviour matches the original JS exactly.
+  // - allowJs + checkJs:false lets converted .ts and remaining .js coexist.
+  // - strict: started as false during conversion; noImplicitAny, then strictNullChecks,
+  //   then full strict were enabled once all of src/ was TS (0 errors each, dist/ output
+  //   byte-identical before/after).
+  "compilerOptions": {
+    "target": "ES2022",
+    "module": "commonjs",
+    "moduleResolution": "node10",
+    "esModuleInterop": false,
+    "allowJs": true,
+    "checkJs": false,
+    "strict": true,
+    "skipLibCheck": true,
+    "forceConsistentCasingInFileNames": true,
+    "types": ["node", "jest"],
+    "outDir": "dist"
+  },
+  "include": ["src", "tests"],
+  // src/server.js is the plain-JS runtime entry that loads ../dist (compiled output).
+  "exclude": ["node_modules", "dist", "src/server.js"]
+}
