@@ -0,0 +1,64 @@
+import express = require('express');
+import store = require('../store');
+import { validateItems } from '../validate';
+import { quote } from '../services/pricing';
+import type { OrderItem } from '../types';
+
+// Request shapes are declared as `unknown` fields: nothing is validated at the type
+// level beyond what the existing runtime checks already do.
+interface CreateOrderBody {
+  items?: unknown;
+  coupon?: unknown;
+}
+interface ListOrdersQuery {
+  status?: unknown;
+}
+interface OrderIdParams {
+  id: string;
+}
+
+const router = express.Router();
+
+router.post<'/', {}, unknown, CreateOrderBody | undefined>('/', (req, res, next) => {
+  const { items, coupon } = req.body || {};
+  const msg = validateItems(items);
+  if (msg) return res.status(400).json({ error: msg });
+  try {
+    // TODO(ts-migration): validateItems() returned null, so items has passed the runtime
+    // checks; it is not a type guard, hence the assertion.
+    const validItems = items as OrderItem[];
+    const q = quote(validItems, coupon);
+    // TODO(ts-migration): coupon is not validated at runtime (any truthy value that is a
+    // known COUPONS key passes); assertion mirrors what the JS stored.
+    const order = store.create({ items: validItems, coupon: (coupon as string) || null, ...q });
+    res.status(201).json(order);
+  } catch (e) { next(e); }
+});
+
+router.get<'/', {}, unknown, unknown, ListOrdersQuery>('/', (req, res) => {
+  const { status } = req.query;
+  const all = store.list();
+  res.json(status ? all.filter(o => o.status === status) : all);
+});
+
+router.get<'/:id', OrderIdParams>('/:id', (req, res) => {
+  const o = store.get(req.params.id);
+  if (!o) return res.status(404).json({ error: 'order not found' });
+  res.json(o);
+});
+
+router.post<'/:id/cancel', OrderIdParams>('/:id/cancel', (req, res) => {
+  const o = store.get(req.params.id);
+  if (!o) return res.status(404).json({ error: 'order not found' });
+  if (o.status === 'shipped') return res.status(409).json({ error: 'shipped order cannot be cancelled' });
+  res.json(store.update(o.id, { status: 'cancelled' }));
+});
+
+router.post<'/:id/ship', OrderIdParams>('/:id/ship', (req, res) => {
+  const o = store.get(req.params.id);
+  if (!o) return res.status(404).json({ error: 'order not found' });
+  if (o.status !== 'pending') return res.status(409).json({ error: `cannot ship ${o.status} order` });
+  res.json(store.update(o.id, { status: 'shipped' }));
+});
+
+export = router;
