+{
+  // Build config: compiles src/ (TS + remaining JS via allowJs) into dist/.
+  // src/server.js is not compiled; it stays the entry run by `npm start`
+  // and requires ../dist/app.
+  "extends": "./tsconfig.json",
+  "compilerOptions": {
+    "rootDir": "src",
+    "outDir": "dist",
+    "noEmit": false,
+    "types": ["node"]
+  },
+  "include": ["src"],
+  "exclude": ["node_modules", "dist", "src/server.js"]
+}
diff --git a/tsconfig.json b/tsconfig.json
new file mode 100644
