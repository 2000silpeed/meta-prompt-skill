+import type { HttpError, OrderItem, Quote } from '../types';
+
+const COUPONS: Record<string, number> = { WELCOME10: 0.1, VIP20: 0.2 };
+
+function subtotal(items: readonly OrderItem[]): number {
+  return items.reduce((s, it) => s + it.price * it.qty, 0);
+}
+
+function quote(items: readonly OrderItem[], coupon?: unknown): Quote {
+  const sub = subtotal(items);
+  // TODO(ts-migration): coupon comes straight from the request body and is not validated;
+  // any truthy value is coerced to a property key here, exactly as in the original JS.
+  const rate = coupon ? COUPONS[coupon as string] : 0;
+  if (coupon && rate === undefined) {
+    const err: HttpError = new Error('unknown coupon');
+    err.status = 400;
+    throw err;
+  }
+  const discount = Math.round(sub * rate);
+  const shipping = sub - discount >= 30000 ? 0 : 3000;
+  return { subtotal: sub, discount, shipping, total: sub - discount + shipping };
+}
+
+export { quote, subtotal, COUPONS };
