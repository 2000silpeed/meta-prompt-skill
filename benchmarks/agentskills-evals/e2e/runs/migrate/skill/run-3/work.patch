diff --git a/src/types/order.ts b/src/types/order.ts
new file mode 100644
index 0000000..f620bc6
--- /dev/null
+++ b/src/types/order.ts
@@ -0,0 +1,26 @@
+// Shared domain types for the TypeScript migration. Type-only module.
+
+export interface OrderItem {
+  sku: string;
+  qty: number;
+  price: number;
+}
+
+export interface Quote {
+  subtotal: number;
+  discount: number;
+  shipping: number;
+  total: number;
+}
+
+export type OrderStatus = 'pending' | 'cancelled' | 'shipped';
+
+export interface Order extends Quote {
+  id: string;
+  status: OrderStatus;
+  items: OrderItem[];
+  coupon: string | null;
+}
+
+/** Fields supplied by the caller of store.create(); id and status are assigned by the store. */
+export type NewOrder = Omit<Order, 'id' | 'status'>;
